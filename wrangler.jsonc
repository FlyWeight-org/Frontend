{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flyweight-frontend",
  "account_id": "9edca68dc3e37bad6304e4bc0da34eca",
  "compatibility_date": "2026-11-20",
  // The site is reachable only through its custom domain, so the workers.dev
  // hostname stays off and cannot serve a copy that bypasses the zone's
  // security-header ruleset.
  "workers_dev": false,
  "routes": [{ "pattern": "flyweight.org", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
}
