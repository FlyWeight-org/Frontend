{
  "name": "flyweight",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --ui",
    "build-only": "vite build",
    "type-check": "pnpm type-check:native && vue-tsc --build",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint \"src/**/*.{vue,css,scss}\"",
    "lint:oxlint": "oxlint -c oxlintrc.json src",
    "lint:knip": "knip",
    "lint": "run-s lint:eslint lint:stylelint lint:oxlint lint:knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check:native": "tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@intlify/core-base": "^11.4.16",
    "@lucide/vue": "^1.66.0",
    "@rails/actioncable": "^8.1.400",
    "@sentry/vue": "^11.10.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@vuepic/vue-datepicker": "^14.0.0",
    "@vueuse/core": "^15.0.0",
    "date-fns": "^4.4.0",
    "is-touch-device": "^1.0.1",
    "lodash-es": "^4.18.1",
    "luxon": "^3.7.2",
    "normalize.css": "^8.0.1",
    "pinia": "^4.1.0",
    "ts-results": "^3.3.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "vue-turnstile": "^1.0.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@flydotio/dockerfile": "^0.7.15",
    "@pinia/testing": "^2.0.2",
    "@playwright/test": "^1.64.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node26": "^26.0.1",
    "@types/is-touch-device": "^1.0.3",
    "@types/jsdom": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/rails__actioncable": "^8.0.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-dom": "^3.5.44",
    "@vue/server-renderer": "^3.5.44",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "npm-run-all2": "^9.0.4",
    "oxlint": "^1.90.0",
    "postal-mime": "^4.2.0",
    "postcss": "^8.5.32",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@12.16.1"
}
